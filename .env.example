# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Required -----------------------------------------------------------

# Bearer token every API call must present.
API_KEY=change-me

# MongoDB backs the async session message bus and the readability cache.
# It must be a replica set: the message bus uses change streams.
MONGO_URI=mongodb://localhost:27017/baas?directConnection=true

# Port the HTTP server listens on.
PORT=8090

# Run as a plain HTTP server rather than through the AWS Lambda adapter.
# These four come from the service framework and are required outside Lambda.
LOCAL_DEBUG=true
SIMPLE_CONTAINER_AWS_LAMBDA_ROUTING_TYPE=function-url
SIMPLE_CONTAINER_AWS_LAMBDA_INVOKE_MODE=BUFFERED
USE_RESPONSE_STREAM=true

# --- Browser ------------------------------------------------------------

# Path to Chrome/Chromium. In the container this path always exists: the base
# image resolves chrome or chromium and symlinks it here. On a host, point it
# at your own install.
BROWSER_EXECUTABLE=/usr/bin/google-chrome

# Run the browser with a visible window instead of headless. Needs an X
# display: the container starts Xvfb for you, on a host you need your own.
# Compose turns this on so the VNC session shows something; headless is faster.
BROWSER_HEADFUL=true

# Directory of unpacked Chrome extensions to load. See profile/Extensions.
# CHROME_EXTENSIONS_DIR=./profile/Extensions

# Verbose Chrome logging.
# CHROME_DEBUG=false

# --- LLM provider -------------------------------------------------------
# Only needed for the llm* browser actions (llmClick, llmLogin, llmText, ...).
# Defaults to "ollama" when unset. Pick one block.

# LLM_CLIENT=openai
# OPENAI_TOKEN=
# OPENAI_ORGANIZATION=
# OPENAI_MODEL=gpt-4-turbo

# LLM_CLIENT=azure-openai
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# LLM_CLIENT=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_API_KEY=

# --- Document processing ------------------------------------------------

# Interpreters and helper scripts used by the PDF/Markdown/HTML endpoints.
# PYTHON_PATH=python3
# NODEJS_PATH=node
# SCRIPTS_DIR=./scripts

# Embedding model used when splitting PDFs for extraction.
# PDF_PARSER_MODEL=text-embedding-3-large
# OPENAI_MIN_TOKENS=64
# OPENAI_MAX_TOKENS=1024

# --- Optional -----------------------------------------------------------

# Upstream proxy for browser traffic. http:// and socks5:// are both accepted.
# PROXY_HOST=socks5://user:pass@proxy:1080

# How long readability results stay cached in MongoDB.
# CACHE_TTL=24h

# External storage service for generated files (PDF/DOCX/HTML/images). It must
# expose POST /api/prepare returning an uploadURL. Leave unset to disable the
# endpoints that return a download link.
# STORAGE_SERVICE_URL=
# STORAGE_SERVICE_API_KEY=

# --- Container runtime --------------------------------------------------
# Read by entrypoint.sh, not by the Go binary.

# SCREEN_RESOLUTION=1920x1080x24
# ALLOWED_IPS=127.0.0.1
# ALLOWED_ORIGINS=http://localhost:8080,https://localhost:8080

# Expose the browser over VNC on port 5900. Requires either a password or an
# explicit opt-out; the container refuses to start VNC with neither.
# ENABLE_VNC=true
# VNC_PASSWORD=
# SE_VNC_NO_PASSWORD=1
